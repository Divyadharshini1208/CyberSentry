{
  "manifest_version": 3,
  "name": "CyberSentry – Agentic Cyber Defense Platform",
  "short_name": "CyberSentry",
  "version": "1.0.0",
  "description": "Real-time AI-ready cybersecurity protection against phishing, malicious domains, deceptive redirects, and dangerous downloads.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/page-monitor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CyberSentry Cyber Defense",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

