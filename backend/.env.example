# ==============================================================================
# SentinelX Platform Configuration (.env.example)
# Copy this file to .env and configure values for your environment.
# Never commit actual production credentials or private keys.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME="CyberSentry Cyber Defense Platform"
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Security & Authentication
# Header authentication: X-SentinelX-Key or Authorization: Bearer <key>
SENTINELX_API_KEY=sentinelx-client-dev-key
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite (async) for zero-setup local development and automated tests
DATABASE_URL=sqlite+aiosqlite:///./sentinelx.db
# Production MySQL Example (async driver):
# DATABASE_URL=mysql+aiomysql://sentinelx_user:your_secure_password@mysql:3306/sentinelx_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS Configuration (narrowly scoped to Chrome extension and local web)
CORS_ORIGINS=["chrome-extension://*","http://localhost:3000","http://127.0.0.1:8000"]

# Rate Limiting & DoS Protection
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=1048576

# Data Retention & Telemetry
TELEMETRY_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=180

# External Threat Intelligence Adapters
# Leave blank to operate in graceful offline / local heuristic mode
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=
URLHAUS_AUTH_KEY=
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_TIMEOUT_SECONDS=4.0

# Multi-Agent Investigation Workflow Settings
AGENT_TIMEOUT_SECONDS=10.0
AGENT_MAX_STEPS=8
AGENT_LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
